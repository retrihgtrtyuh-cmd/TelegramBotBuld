# ============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ / SECRETS (Hugging Face Spaces / Render / VPS)
# ============================================================================

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN="ВАШ_ТОКЕН_БОТА_ОТ_BOTFATHER"

# Строгий ID администратора бота (ваш личный числовой Telegram User ID)
ADMIN_ID="ВАШ_ЛИЧНЫЙ_TELEGRAM_USER_ID"

# Разрешенные ID чатов/канала для доставки APK (через запятую)
TELEGRAM_CHAT_ID="ВАШ_CHAT_ID_ИЛИ_ID_КАНАЛА"
TELEGRAM_CHAT_IDS="ВАШ_CHAT_ID_ИЛИ_ID_КАНАЛА"

# GitHub Personal Access Token (права: Contents R/W, Actions R/W, Secrets R/W)
GITHUB_PAT="github_pat_ВАШ_ТОКЕН"

# Целевой профиль и репозиторий GitHub (считываются только из окружения)
GITHUB_OWNER="ВАШ_GITHUB_ЛОГИН"
GITHUB_REPO="ВАШ_РЕПОЗИТОРИЙ"
GITHUB_WORKFLOW="build-and-deploy.yml"
GITHUB_BRANCH="main"

# Обязательный секрет для авторизации входящих APK на /api/upload-apk
WEBHOOK_SECRET="СГЕНЕРИРУЙТЕ_ДЛИННЫЙ_СЛУЧАЙНЫЙ_СЕКРЕТ"

# Порт HTTP-сервера (7860 — стандарт для Hugging Face Spaces)
PORT="7860"
