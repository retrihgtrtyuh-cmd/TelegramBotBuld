# ============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ TELEGRAM-БОТА (Render / Railway / VPS)
# ============================================================================

# Токен вашего Telegram-бота (от @BotFather)
TELEGRAM_BOT_TOKEN="1234567890:AAH_your_telegram_bot_token_here"

# Разрешенные Chat ID (через запятую), которым бот отправляет APK и разрешает команду /build
TELEGRAM_CHAT_IDS="123456789,-100987654321"

# GitHub Personal Access Token (Fine-grained с правами Contents: Read & Write и Actions: Read & Write)
GITHUB_PAT="github_pat_11ABCDEFG_your_token_here"

# Владелец репозитория (логин или организация на GitHub) и название репозитория
GITHUB_OWNER="studio-games"
GITHUB_REPO="mobile-rpg-client"
GITHUB_BRANCH="main"

# Секретный ключ для защиты HTTP-эндпоинта /api/upload-apk от посторонних запросов
WEBHOOK_SECRET="super_secret_hmac_token_2026"

# Порт встроенного HTTP-сервера aiohttp (Render и Railway подставляют PORT автоматически)
PORT="8080"

# Путь к файлу журнала разработки в корне проекта
DEV_LOG_PATH="../dev_log.md"
